#include <windows.h>

IDI_ICON1               ICON    DISCARDABLE     "favicon.ico"

// Version resource. Every value comes from version.pri via qmake DEFINES, so the
// executable properties, the window title and the About box can never disagree.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     PROJECT_DEFINED_APP_VER_1,PROJECT_DEFINED_APP_VER_2,PROJECT_DEFINED_APP_VER_3,PROJECT_DEFINED_APP_VER_4
PRODUCTVERSION  PROJECT_DEFINED_APP_VER_1,PROJECT_DEFINED_APP_VER_2,PROJECT_DEFINED_APP_VER_3,PROJECT_DEFINED_APP_VER_4
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      PROJECT_DEFINED_APP_COMPANY
            VALUE "FileDescription",  PROJECT_DEFINED_APP_NAME
            VALUE "FileVersion",      PROJECT_DEFINED_APP_VER
            VALUE "InternalName",     PROJECT_DEFINED_APP_NAME
            VALUE "OriginalFilename", "autoremesher.exe"
            VALUE "ProductName",      PROJECT_DEFINED_APP_NAME
            VALUE "ProductVersion",   PROJECT_DEFINED_APP_HUMAN_VER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
